[Unit]
Description=Heying Project Club backend (FastAPI)
After=network.target mongod.service

[Service]
Type=simple
User=root
WorkingDirectory=/www/wwwroot/heying/backend
ExecStart=/www/wwwroot/heying/backend/.venv/bin/uvicorn server:app --host 127.0.0.1 --port 8001 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

MONGO_URL=mongodb://mongo:27017
DB_NAME=heying
JWT_SECRET=请换成一串随机长字符串_至少32位
ADMIN_USERNAME=admin
ADMIN_PASSWORD=请换成强密码_首次启动用它创建管理员
EMERGENT_LLM_KEY=从Emergent面板Secrets复制的通用密钥_AI客服和图片上传依赖它
# 国内服务器推荐：开启后图片存服务器本地，AI 走国内大模型直连
LOCAL_STORAGE=1
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=到_platform.deepseek.com_申请后粘贴到这里
AI_MODEL=deepseek-chat
